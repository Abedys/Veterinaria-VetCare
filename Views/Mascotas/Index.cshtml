@{
    ViewData["Title"] = "Gestión de Mascotas";
}

<!-- Encabezado y Botón Crear -->
<div class="row mb-3">
    <div class="col-md-8 d-flex align-items-center gap-2">
        <i class="bi bi-paw fs-3 text-primary"></i>
        <h1 class="mb-0 text-primary">Listado de Mascotas</h1>
    </div>

    <div class="col-md-4 text-end">
        <button type="button" class="btn btn-primary" onclick="openModal(false)">
            <i class="fa-solid fa-circle-plus me-1"></i>
            Crear Mascota
        </button>
    </div>
</div>

<!-- Tabla DataTable de Mascotas -->
<div class="row">
    <div class="col-md-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover align-middle w-100" id="tbmascota">
                    <thead class="table-dark">
                        <tr>
                            <th>Nombre</th>
                            <th>Especie</th>
                            <th>Raza</th>
                            <th>Propietario</th>
                            <th>Fecha Nacimiento</th>
                            <th>Peso</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                    <tfoot>
                        <tr>
                            <th><input type="text" class="form-control form-control-sm filtro-mascota" id="filtroNombre" data-col="0" placeholder="Nombre..." /></th>
                            <th><select class="form-select form-select-sm filtro-mascota" id="filtroEspecie" data-col="1"><option value="">Especie</option></select></th>
                            <th><select class="form-select form-select-sm filtro-mascota" id="filtroRaza" data-col="2"><option value="">Raza</option></select></th>
                            <th><select class="form-select form-select-sm filtro-mascota" id="filtroPropietario" data-col="3"><option value="">Propietario</option></select></th>
                            <th><select class="form-select form-select-sm filtro-mascota" id="filtroFecha" data-col="4"><option value="">Fecha nac.</option></select></th>
                            <th><input type="number" step="0.01" min="0" class="form-control form-control-sm filtro-mascota" id="filtroPeso" data-col="5" placeholder="Peso..." /></th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Crear / Editar Mascota -->
<div class="modal fade" id="modalMascota" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="IdTitleMascota">Crear Mascota</h5>
                <button type="button" class="btn-close" onclick="clearFormMascota()"></button>
            </div>
            <div class="modal-body">
                <form id="formMascota">
                    <!-- Fila 1: Nombre, Fecha Nacimiento, Peso -->
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label fw-semibold">Nombre de la Mascota <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtNombre" placeholder="Ej: Max, Luna" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Fecha de Nacimiento</label>
                            <input type="date" class="form-control" id="txtFechaNacimiento" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Peso (kg) <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" min="0" class="form-control" id="txtPeso" placeholder="Ej: 8.5" />
                        </div>
                    </div>

                    <!-- Fila 2: Especie y Raza (Combos dependientes) -->
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Especie <span class="text-danger">*</span></label>
                            <select id="cmbEspecies" class="form-select" onchange="changeCmbEspecies()">
                                <option value="" disabled selected>Seleccione una especie</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Raza <span class="text-danger">*</span></label>
                            <select id="cmbRazas" class="form-select" onchange="changeCmbRazas()">
                                <option value="" disabled selected>Primero seleccione una especie</option>
                            </select>
                        </div>
                    </div>

                    <!-- Fila 3: Propietario -->
                    <div class="row g-3 mt-1">
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Propietario Responsable <span class="text-danger">*</span></label>
                            <select id="cmbPropietarios" class="form-select" onchange="changeCmbPropietarios()">
                                <option value="" disabled selected>Seleccione un propietario</option>
                            </select>
                        </div>
                    </div>

                    <!-- Fila 4: Galería de Imágenes (Modo Edición) -->
                    <div class="row mt-3" id="sectionMascotaImages" style="display:none;">
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Fotos de la Mascota</label>
                            <div id="mascotaImagesGallery" class="d-flex flex-wrap gap-2 p-2 border rounded bg-light"></div>
                        </div>
                    </div>

                    <!-- Fila 5: Selector de Archivos (Subida de fotos) -->
                    <div class="row mt-3" id="sectionFileMascota">
                        <div class="col-md-12">
                            <input type="file" class="d-none" id="fileMascota" accept="image/*" multiple />
                            <button type="button" class="btn btn-outline-primary w-100 text-start py-2" id="btnFileMascota" onclick="triggerFileMascota()">
                                <i class="fa-solid fa-cloud-arrow-up me-2"></i>
                                <span id="fileMascotaText">Seleccionar imágenes (opcional)</span>
                            </button>
                            <small class="text-muted">Formatos permitidos: .jpg, .jpeg, .png, .webp (Máx. 5 MB por archivo)</small>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" onclick="clearFormMascota()">Cerrar</button>
                <button id="btnModalSave" type="button" class="btn btn-success" onclick="onSaveMascota()">Crear</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        var isEdit = false;
        var listMascotas = [];
        var listEspecies = [];
        var listRazas = [];
        var listPropietarios = [];

        var idMascota = 0;
        var idEspecie = 0;
        var idRaza = 0;
        var idPropietario = 0;

        var fileMascotaDefaultText = 'Seleccionar imágenes (opcional)';

        $(document).ready(function () {
            getAllMascotas();
            getEspeciesCombo();
            getPropietariosCombo();
            $('#fileMascota').on('change', onFileMascotaChange);

            bindColumnFilters();
        });

        // ============================================
        // Gestión del Selector de Archivos
        // ============================================
        function triggerFileMascota() {
            $('#fileMascota').click();
        }

        function resetFilesMascotaLabel() {
            //$('#fileMascota').val('');
            $('#fileMascotaText').text(fileMascotaDefaultText);
        }

        function onFileMascotaChange() {
            var fileInput = $('#fileMascota')[0];
            if (!fileInput.files || fileInput.files.length === 0) {
                resetFilesMascotaLabel();
                return;
            }

            if (fileInput.files.length === 1) {
                $('#fileMascotaText').text(fileInput.files[0].name);
            } else {
                $('#fileMascotaText').text(fileInput.files.length + ' imágenes seleccionadas');
            }

            // Si estamos editando y se seleccionan imágenes nuevas, subirlas de inmediato
            if (idMascota !== 0) {
                addMascotaImages();
            }
        }

        function addMascotaImages() {
            var fileInput = $('#fileMascota')[0];
            //if (!fileInput.files || fileInput.files.length === 0) return;

            var formData = new FormData();
            formData.append('idMascota', idMascota);

            for (var i = 0; i < fileInput.files.length; i++) {
                formData.append('fileMascota', fileInput.files[i]);
            }

            $.ajax({
                url: '@Url.Action("AddMascotaImages", "File")',
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                success: function () {
                    toastMessage('success', 'Imágenes subidas exitosamente');
                    resetFilesMascotaLabel();
                    getMascotaImages(idMascota);
                },
                error: function (error) {
                    errorHttp(error);
                }
            });
        }

        // ============================================
        // Carga de Combos (Especies, Razas, Propietarios)
        // ============================================
        function getEspeciesCombo(selectedId = null) {
            $.ajax({
                url: '@Url.Action("GetAllEspecies", "Especies")',
                method: 'GET',
                dataType: 'json',
                success: function (result) {
                    listEspecies = result;
                    loadCmbEspecies(listEspecies, selectedId);
                },
                error: function (error) {
                    console.error(error);
                }
            });
        }

        function loadCmbEspecies(data, selectedId) {
            var cmb = $("#cmbEspecies");
            cmb.empty();
            cmb.append('<option value="" disabled ' + (!selectedId ? 'selected' : '') + '>Seleccione una especie</option>');
            $.each(data, function (i, item) {
                var isSelected = (selectedId && item.id == selectedId) ? 'selected' : '';
                cmb.append('<option value="' + item.id + '" ' + isSelected + '>' + item.nombre + '</option>');
            });
        }

        function changeCmbEspecies() {
            idEspecie = parseInt($('#cmbEspecies').val()) || 0;
            idRaza = 0;
            getRazasByEspecie(idEspecie);
        }

        function getRazasByEspecie(idEspecieParam, selectedRazaId = null) {
            var cmbRaza = $("#cmbRazas");
            cmbRaza.empty();

            if (!idEspecieParam || idEspecieParam === 0) {
                cmbRaza.append('<option value="" disabled selected>Primero seleccione una especie</option>');
                return;
            }

            $.ajax({
                url: '@Url.Action("GetRazasByEspecie", "Raza")',
                method: 'GET',
                data: { idEspecie: idEspecieParam },
                dataType: 'json',
                success: function (result) {
                    listRazas = result;
                    cmbRaza.append('<option value="" disabled ' + (!selectedRazaId ? 'selected' : '') + '>Seleccione una raza</option>');
                    $.each(result, function (i, item) {
                        var isSelected = (selectedRazaId && item.id == selectedRazaId) ? 'selected' : '';
                        cmbRaza.append('<option value="' + item.id + '" ' + isSelected + '>' + item.nombre + '</option>');
                    });
                },
                error: function (error) {
                    console.error(error);
                }
            });
        }

        function changeCmbRazas() {
            idRaza = parseInt($('#cmbRazas').val()) || 0;
        }

        function getPropietariosCombo(selectedId = null) {
            $.ajax({
                url: '@Url.Action("GetAllPropietarios", "Propietarios")',
                method: 'GET',
                dataType: 'json',
                success: function (result) {
                    listPropietarios = result;
                    loadCmbPropietarios(listPropietarios, selectedId);
                },
                error: function (error) {
                    console.error(error);
                }
            });
        }

        function loadCmbPropietarios(data, selectedId) {
            var cmb = $("#cmbPropietarios");
            cmb.empty();
            cmb.append('<option value="" disabled ' + (!selectedId ? 'selected' : '') + '>Seleccione un propietario</option>');
            $.each(data, function (i, item) {
                var isSelected = (selectedId && item.id == selectedId) ? 'selected' : '';
                cmb.append('<option value="' + item.id + '" ' + isSelected + '>' + item.nombreCompleto + '</option>');
            });
        }

        function changeCmbPropietarios() {
            idPropietario = parseInt($('#cmbPropietarios').val()) || 0;
        }

        // ============================================
        // Consulta y Renderizado de Mascotas
        // ============================================
        function getAllMascotas() {
            $.ajax({
                url: '@Url.Action("GetAllMascotas", "Mascotas")',
                method: 'GET',
                dataType: 'json',
                success: function (result) {
                    listMascotas = result;
                    loadTable(listMascotas);
                },
                error: function (error) {
                    errorHttp(error);
                }
            });
        }

        function loadTable(data) {
            $('#tbmascota').DataTable({
                data: data,
                destroy: true,
                responsive: true,
                pageLength: 10,
                language: {
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ mascotas",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ mascotas",
                    infoEmpty: "No hay mascotas disponibles",
                    infoFiltered: "(filtrado de _MAX_ mascotas)",
                    zeroRecords: "No se encontraron mascotas",
                    paginate: {
                        first: "Primero",
                        last: "Último",
                        next: "Siguiente",
                        previous: "Anterior"
                    }
                },
                columns: [
                    {
                        data: 'nombre',
                        className: 'fw-bold',
                        render: function (data, type, row) {
                            var foto = row.fotoPerfil
                                ? `<img src="${row.fotoPerfil}" class="rounded-circle object-fit-cover me-2" style="width:36px;height:36px;" onerror="this.style.display='none'" alt="Foto mascota" />`
                                : `<i class="bi bi-paw-circle-fill text-primary me-2" style="font-size:1.4rem;"></i>`;
                            return `${foto}<span>${data}</span>`;
                        }
                    },
                    {
                        data: 'especie',
                        render: function (data) {
                            return `<span class="badge rounded-pill bg-success">${data ?? 'Sin especie'}</span>`;
                        }
                    },
                    {
                        data: 'raza',
                        render: function (data) {
                            return `<span class="badge rounded-pill bg-info text-dark">${data ?? 'Sin raza'}</span>`;
                        }
                    },
                    { data: 'nombrePropietario' },
                    {
                        data: 'fechaNacimiento',
                        render: function (data) {
                            if (!data) return '<span class="text-muted">No registrada</span>';
                            const parts = data.split('-');
                            if (parts.length === 3) {
                                return `${parts[2]}/${parts[1]}/${parts[0]}`;
                            }
                            const fecha = new Date(data);
                            return fecha.toLocaleDateString('es-CO');
                        }
                    },
                    {
                        data: 'peso',
                        render: function (data) {
                            return `<span class="fw-semibold">${data ?? 0} kg</span>`;
                        }
                    },
                    {
                        data: null,
                        className: 'text-center',
                        orderable: false,
                        render: function (data) {
                            return `
                                <div class="d-flex justify-content-center align-items-center gap-2">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            onclick="editMascota(${data.id})"
                                            title="Editar mascota">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="deleteMascota(${data.id})"
                                            title="Eliminar mascota">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            `;
                        }
                    }
                ]
            });

            populateColumnFilters(data);
        }

        // ============================================
        // Filtros por Columna
        // ============================================
        function bindColumnFilters() {
            $('#filtroNombre, #filtroPeso').on('keyup change', function () {
                var col = parseInt($(this).data('col'));
                $('#tbmascota').DataTable().column(col).search(this.value).draw();
            });

            $('#filtroEspecie, #filtroRaza, #filtroPropietario, #filtroFecha').on('change', function () {
                var col = parseInt($(this).data('col'));
                $('#tbmascota').DataTable().column(col).search(this.value).draw();
            });
        }

        function populateColumnFilters(list) {
            if (!list || list.length === 0) return;

            var especies = {};
            var razas = {};
            var propietarios = {};
            var fechas = {};

            list.forEach(function (m) {
                if (m.especie) especies[m.especie] = 1;
                if (m.raza) razas[m.raza] = 1;
                if (m.nombrePropietario) propietarios[m.nombrePropietario] = 1;
                if (m.fechaNacimiento) {
                    var f = m.fechaNacimiento.split('-');
                    if (f.length === 3) {
                        fechas[f[2] + '/' + f[1] + '/' + f[0]] = 1;
                    }
                }
            });

            fillSelectFilter('#filtroEspecie', especies);
            fillSelectFilter('#filtroRaza', razas);
            fillSelectFilter('#filtroPropietario', propietarios);
            fillSelectFilter('#filtroFecha', fechas);
        }

        function fillSelectFilter(selector, obj) {
            var $sel = $(selector);
            var current = $sel.val();
            var keys = Object.keys(obj).sort();

            $sel.find('option').not(':first').remove();
            keys.forEach(function (key) {
                $sel.append('<option value="' + key + '">' + key + '</option>');
            });
            $sel.val(current);
        }

        // ============================================
        // Modal y Galería de Fotos
        // ============================================
        function openModal(editMode) {
            isEdit = editMode;
            if (isEdit) {
                $('#IdTitleMascota').html('<i class="bi bi-pencil-square me-1"></i> Editar Mascota');
                $('#btnModalSave').html('Actualizar');
                $('#sectionMascotaImages').show();
            } else {
                $('#IdTitleMascota').html('<i class="bi bi-plus-circle me-1"></i> Crear Mascota');
                $('#btnModalSave').html('Crear');
                $('#sectionMascotaImages').hide();
            }
            $('#modalMascota').modal('show');
        }

        function clearFormMascota() {
            $('#txtNombre').val('');
            $('#txtFechaNacimiento').val('');
            $('#txtPeso').val('');
            $('#cmbEspecies').val('');
            $('#cmbRazas').empty().append('<option value="" disabled selected>Primero seleccione una especie</option>');
            $('#cmbPropietarios').val('');

            resetFilesMascotaLabel();
            $('#mascotaImagesGallery').empty();
            $('#sectionMascotaImages').hide();

            idMascota = 0;
            idEspecie = 0;
            idRaza = 0;
            idPropietario = 0;

            $('#modalMascota').modal('hide');
        }

        function getMascotaImages(idMascotaParam) {
            $.ajax({
                url: '@Url.Action("GetMascotaImages", "File")',
                method: 'GET',
                data: { idMascota: idMascotaParam },
                dataType: 'json',
                success: function (result) {
                    renderMascotaImages(result);
                },
                error: function (error) {
                    errorHttp(error);
                }
            });
        }

        function renderMascotaImages(images) {
            var gallery = $('#mascotaImagesGallery');
            gallery.empty();

            if (!images || images.length === 0) {
                gallery.append('<p class="text-muted mb-0 small fst-italic">No hay fotos registradas para esta mascota.</p>');
                return;
            }

            $.each(images, function (i, image) {
                gallery.append(`
                    <div class="position-relative border rounded p-1 bg-white shadow-sm" style="width:110px;">
                        <a href="${image.url}" class="glightbox" data-gallery="mascota-gallery-${image.idMascota}">
                            <img src="${image.url}" alt="Foto mascota" class="img-fluid rounded" style="height:90px; width:100%; object-fit:cover; cursor:pointer;" />
                        </a>
                        <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1 p-0 px-1"
                                onclick="deleteMascotaImage(${image.idFile}, ${image.idMascota})" title="Eliminar foto">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                `);
            });

            if (typeof GLightbox !== 'undefined') {
                GLightbox({ selector: '#mascotaImagesGallery .glightbox' });
            }
        }

        function deleteMascotaImage(idFile, idMascotaParam) {
            alertDelete().then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("DeleteMascotaImage", "File")',
                        method: 'DELETE',
                        data: { idFile: idFile, idMascota: idMascotaParam },
                        dataType: 'json',
                        success: function () {
                            toastMessage('success', 'Foto eliminada');
                            getMascotaImages(idMascotaParam);
                        },
                        error: function (error) {
                            errorHttp(error);
                        }
                    });
                }
            });
        }

        // ============================================
        // Operaciones CRUD (Crear, Editar, Eliminar)
        // ============================================
        function editMascota(id) {
            var mascota = listMascotas.find(m => m.id == id);
            if (!mascota) {
                $.ajax({
                    url: '@Url.Action("GetMascotaById", "Mascotas")',
                    method: 'GET',
                    data: { id: id },
                    dataType: 'json',
                    success: function (result) {
                        populateEditMascota(result);
                    },
                    error: function (error) {
                        errorHttp(error);
                    }
                });
            } else {
                populateEditMascota(mascota);
            }
        }

        function populateEditMascota(mascota) {
            idMascota = mascota.id;
            $('#txtNombre').val(mascota.nombre);
            $('#txtFechaNacimiento').val(mascota.fechaNacimiento ? mascota.fechaNacimiento.substring(0, 10) : '');
            $('#txtPeso').val(mascota.peso);

            idPropietario = mascota.idPropietario;
            $('#cmbPropietarios').val(idPropietario);

            idRaza = mascota.idRaza;

            // Encontrar la especie correspondiente a esta raza
            $.ajax({
                url: '@Url.Action("GetAllRazas", "Raza")',
                method: 'GET',
                dataType: 'json',
                success: function (razas) {
                    var currentRaza = razas.find(r => r.id == idRaza);
                    if (currentRaza) {
                        idEspecie = currentRaza.idEspecie;
                        $('#cmbEspecies').val(idEspecie);
                        getRazasByEspecie(idEspecie, idRaza);
                    }
                }
            });

            getMascotaImages(idMascota);
            openModal(true);
        }

        function validateForm() {
            if ($.trim($('#txtNombre').val()) === '') {
                $('#txtNombre').focus();
                toastMessage('warning', 'El nombre de la mascota es obligatorio');
                return false;
            }

            if ($.trim($('#txtPeso').val()) === '') {
                $('#txtPeso').focus();
                toastMessage('warning', 'El peso es obligatorio');
                return false;
            }

            if (!$('#cmbEspecies').val()) {
                $('#cmbEspecies').focus();
                toastMessage('warning', 'Debe seleccionar una especie');
                return false;
            }

            if (!$('#cmbRazas').val()) {
                $('#cmbRazas').focus();
                toastMessage('warning', 'Debe seleccionar una raza');
                return false;
            }

            if (!$('#cmbPropietarios').val()) {
                $('#cmbPropietarios').focus();
                toastMessage('warning', 'Debe seleccionar un propietario');
                return false;
            }

            return true;
        }

        function onSaveMascota() {
            if (!validateForm()) return;

            if (idMascota === 0) {
                addMascota();
            } else {
                updateMascota();
            }
        }

        function addMascota() {
            var formData = new FormData();
            formData.append('Nombre', $.trim($('#txtNombre').val()));
            formData.append('Peso', parseFloat($('#txtPeso').val()));

            var fecha = $('#txtFechaNacimiento').val();
            if (fecha) {
                formData.append('FechaNacimiento', fecha);
            }

            formData.append('IdRaza', parseInt($('#cmbRazas').val()));
            formData.append('IdPropietario', parseInt($('#cmbPropietarios').val()));

            var fileInput = $('#fileMascota')[0];
            if (fileInput.files && fileInput.files.length > 0) {
                for (var i = 0; i < fileInput.files.length; i++) {
                    formData.append('fileMascota', fileInput.files[i]);
                }
            }

            $.ajax({
                url: '@Url.Action("AddMascota", "Mascotas")',
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                success: function () {
                    alertSucces('Mascota creada exitosamente');
                    clearFormMascota();
                    getAllMascotas();
                },
                error: function (error) {
                    errorHttp(error);
                }
            });
        }

        function updateMascota() {
            var updateDto = {
                id: idMascota,
                nombre: $.trim($('#txtNombre').val()),
                peso: parseFloat($('#txtPeso').val()),
                fechaNacimiento: $('#txtFechaNacimiento').val() || null,
                idRaza: parseInt($('#cmbRazas').val()),
                idPropietario: parseInt($('#cmbPropietarios').val())
            };

            console.log(updateDto);
            $.ajax({
                url: '@Url.Action("UpdateMascota", "Mascotas")',
                method: 'PUT',
                data: updateDto,
                dataType: 'json',
                success: function (result) {
                    alertSucces('Mascota actualizada exitosamente');
                    clearFormMascota();
                    getAllMascotas();
                },
                error: function (error) {
                    errorHttp(error);
                }
            });
        }

        function deleteMascota(id) {
            alertDelete().then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("DeleteMascota", "Mascotas")',
                        method: 'DELETE',
                        data: { id: id },
                        dataType: 'json',
                        success: function () {
                            toastMessage('success', 'Mascota eliminada exitosamente');
                            getAllMascotas();
                        },
                        error: function (error) {
                            errorHttp(error);
                        }
                    });
                }
            });
        }
    </script>
}

