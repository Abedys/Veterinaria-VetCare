@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mt-5">
    <i class="bi bi-heart-pulse text-primary" style="font-size: 5rem;"></i>
    <h1 class="display-4 fw-bold text-primary">Veterinaria</h1>
    <p class="lead text-muted">Gestiona las mascotas, propietarios, especies y razas de tu clínica veterinaria.</p>

    @{
        var isLogged = !string.IsNullOrEmpty(Context.Session.GetString("UserName"));
    }

    @if (!isLogged)
    {
        <div class="mt-4 d-flex justify-content-center gap-2">
            <a class="btn btn-primary btn-lg" asp-controller="User" asp-action="Index">
                <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar sesión
            </a>
            <a class="btn btn-outline-primary btn-lg" asp-controller="User" asp-action="Register">
                <i class="bi bi-person-plus me-1"></i>Registrarse
            </a>
        </div>
    }
</div>