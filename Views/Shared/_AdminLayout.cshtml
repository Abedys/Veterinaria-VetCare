<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Veterinaria</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Veterinaria.styles.css" asp-append-version="true" />
    <link href="https://cdn.datatables.net/v/dt/dt-2.3.8/datatables.min.css" rel="stylesheet"
          integrity="sha384-1BvCnyKidMPIGQGjvMn+w+90hHBhYJtF+R7os4NX2Abe7tSxWQadHRTSH5qb559A"
          crossorigin="anonymous">
</head>


<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-heart-pulse text-primary"></i> Veterinaria
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarCollapse" aria-controls="sidebarCollapse"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        <li class="nav-item">
                            <span class="navbar-text fw-semibold">
                                <i class="bi bi-person-circle text-primary me-1"></i>@Context.Session.GetString("FullName")
                            </span>
                        </li>
                        <li class="nav-item">
                            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2">
                                <i class="bi bi-shield-lock me-1"></i>@Context.Session.GetString("UserRol")
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-danger btn-sm" asp-area="" asp-controller="User" asp-action="Logout">
                                <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Animacion de cargando-->
    <div id="overlay" class="overlay">
        <div class="loader">
            <img src="/img/Cube-loading.gif" alt="loading..." id="loadingimg" />
            <p>Cargando...</p>
        </div>

    </div>

    <div class="container-fluid admin-container">
        <div class="row">
            <!-- Sidebar vertical -->
            <aside class="col-lg-2 col-md-3 d-md-block bg-white border-end sidebar-wrapper" id="sidebarCollapse">
                <nav class="navbar navbar-expand-md align-content-start w-100 p-0">
                    <div class="collapse navbar-collapse show d-md-flex flex-column align-items-stretch w-100" id="navbarCollapse">
                        <ul class="nav flex-column w-100 mt-2">
                            <li class="nav-item">
                                <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Mascotas" ? "active" : "")"
                                   asp-controller="Mascotas" asp-action="Index">
                                    <i class="bi bi-paw me-2"></i>Mascotas
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Propietarios" ? "active" : "")"
                                   asp-controller="Propietarios" asp-action="Index">
                                    <i class="bi bi-person-heart me-2"></i>Propietarios
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Especies" ? "active" : "")"
                                   asp-controller="Especies" asp-action="Index">
                                    <i class="bi bi-flower1 me-2"></i>Especies
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Raza" ? "active" : "")"
                                   asp-controller="Raza" asp-action="Index">
                                    <i class="bi bi-bezier2 me-2"></i>Razas
                                </a>
                            </li>
                            @if (Context.Session.GetString("UserRol") == "SuperAdmin")
                            {
                                <li class="nav-item">
                                    <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "GestionUsuarios" ? "active" : "")"
                                       asp-controller="GestionUsuarios" asp-action="Index">
                                        <i class="bi bi-people me-2"></i>Gestión de Usuarios
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </nav>
            </aside>

            <!-- Contenido central -->
            <main role="main" class="col-lg-10 col-md-9 content-wrapper p-4">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - Veterinaria - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- script de conexion con SweetAlert-->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- script de conexion con DataTable-->
    <script src="https://cdn.datatables.net/v/dt/dt-2.3.8/datatables.min.js"
        integrity="sha384-kjkli48Tmhwhaghq0IIRm8gFmMdnihfu1ywAOyyGWYMsoZZi/6AX2fWzpsqahoFw"
        crossorigin="anonymous"></script>
    <!-- script para usar libreria de zoom-->
    <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>

    <!-- esto es para poder el lenguaje del datable en español-->
    <script>
        $.extend(true, $.fn.dataTable.default, {
            lenguaje: {
                url: 'https://cdn.datatables.net/plug-ins/2.3.8/i18n/es-ES.json'
            }
        });

    </script>

    @await RenderSectionAsync("Scripts", required: false)


    <script>

        //Funcion para amndar mensajes de Alerta a los Usuarios
        function toastMessage(type, message){
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            });

            Toast.fire({
                icon: type,
                title: message
            });
        }

        function alertDelete(){
            return Swal.fire({
                title:'¿Confirmar eliminación?',
                text:'¡No podrás revertir esto!',
                icon:'question',
                showCancelButton:true,
                cancelButtonText:'Cancelar',
                confirmButtonText:'Si, eliminar!',
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
            });
        }


        function alertSucces(message, title = null) {
            const alertTitle = title != null ? title : "Exitoso!";
            return Swal.fire({
                 title: alertTitle,
                 text: message,
                 icon: 'success',
                 confirmButtonColor: '#3085d6',
                 confirmButtonText: 'Aceptar!',
            });
        }

        function alertWarning(message, title = null) {

            const alertTitle = title != null ? title : "Alerta!";
            return Swal.fire({
                title: alertTitle,
                text: message,
                icon: 'warning',
                confirmButtonColor: '#3085d6',
                confirmButtonText: 'Aceptar!',
            });
        }

        function alertError(message, title = null) {

            const alertTitle = title != null ? title : "Opps!";
            return Swal.fire({
                title: alertTitle,
                text: message,
                icon: 'error',
                confirmButtonColor: '#3085d6',
                confirmButtonText: 'Aceptar!',
            });

        }

        function errorHttp(error){
            if (error.status == 400 || 401){

                alertWarning(error.responseJSON.message)
            }else
            {
                alertError(error.responseJSON.message)

            }
            console.error(error);

        }


        //mostrar el leader durante las solicitudes AJAX
        $(document).ajaxStart(function(){
            $("#overlay").css("display", "flex");
        });

        $(document).ajaxStop(function () {
            $("#overlay").css("display", "none");
        });


    </script>
</body>
</html>