<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Veterinaria</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" rel="stylesheet" />
    <!-- link de bosstrap icons-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Veterinaria.styles.css" asp-append-version="true" />
    <link href="https://cdn.datatables.net/v/dt/dt-2.3.8/datatables.min.css" rel="stylesheet"
          integrity="sha384-1BvCnyKidMPIGQGjvMn+w+90hHBhYJtF+R7os4NX2Abe7tSxWQadHRTSH5qb559A"
          crossorigin="anonymous">
</head>


<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Veterinaria</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Mascotas" asp-action="Index">Mascotas</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Animacion de cargando-->
    <div id="overlay" class="overlay">
        <div class="loader">
            <img src="/img/Cube-loading.gif" alt="loading..." id="loadingimg" />
            <p>Cargando...</p>
        </div>

    </div>


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>



    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Veterinaria - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- script de conexion con SweetAlert-->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- script de conexion con DataTable-->
    <script src="https://cdn.datatables.net/v/dt/dt-2.3.8/datatables.min.js" 
        integrity="sha384-kjkli48Tmhwhaghq0IIRm8gFmMdnihfu1ywAOyyGWYMsoZZi/6AX2fWzpsqahoFw" 
        crossorigin="anonymous"></script>
    <!-- script para usar libreria de zoom-->
    <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>

    <!-- esto es para poder el lenguaje del datable en español-->
    <script>
        $.extend(true, $.fn.dataTable.default, {
            lenguaje: {
                url: 'https://cdn.datatables.net/plug-ins/2.3.8/i18n/es-ES.json'
            }
        });

    </script>

    @await RenderSectionAsync("Scripts", required: false)


    <script>

        //Funcion para amndar mensajes de Alerta a los Usuarios
        function toastMessage(type, message){
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            });

            Toast.fire({
                icon: type,
                title: message
            });
        }

        function alertDelete(){
            return Swal.fire({
                title:'¿Confirmar eliminación?',
                text:'¡No podrás revertir esto!',
                icon:'question',
                showCancelButton:true,
                cancelButtonTexxt:'Cancelar',
                confirmButtonText:'Si, eliminar!',
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',

            });
        }


        function alertSucces(message, title = null) {
            const alertTitle = title != null ? title : "Exitoso!";
            return Swal.fire({
                 title: alertTitle,
                 text: message,
                 icon: 'success',
                 confirmButtonColor: '#3085d6',
                 confirmButtonText: 'Aceptar!',
            });
        }

        function alertWarning(message, title = null) {

            const alertTitle = title != null ? title : "Alerta!";
            return Swal.fire({
                title: alertTitle,
                text: message,
                icon: 'warning',
                confirmButtonColor: '#3085d6',
                confirmButtonText: 'Aceptar!',
            });
        }

        function alertError(message, title = null) {

            const alertTitle = title != null ? title : "Opps!";
            return Swal.fire({
                title: alertTitle,
                text: message,
                icon: 'error',
                confirmButtonColor: '#3085d6',
                confirmButtonText: 'Aceptar!',
            });

        }

        function errorHttp(error){
            if (error.status == 400 || 401){

                alertWarning(error.responseJSON.message)
            }else
            {
                alertError(error.responseJSON.message)

            }
            console.error(error);

        }

        //mostrar el leader durante las solicitudes AJAX
        $(document).ajaxStart(function(){
            $("#overlay").css("display", "flex");
        });

        $(document).ajaxStop(function () {
            $("#overlay").css("display", "none");
        });


    </script>
</body>
</html>
