<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Veterinaria</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Veterinaria.styles.css" asp-append-version="true" />
    <link href="https://cdn.datatables.net/v/dt/dt-2.3.8/datatables.min.css" rel="stylesheet"
          integrity="sha384-1BvCnyKidMPIGQGjvMn+w+90hHBhYJtF+R7os4NX2Abe7tSxWQadHRTSH5qb559A"
          crossorigin="anonymous">
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-heart-pulse text-primary"></i> Veterinaria
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarCollapse" aria-controls="sidebarCollapse"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        <li class="nav-item">
                            <span class="navbar-text fw-semibold">
                                <i class="bi bi-person-circle text-primary me-1"></i>@Context.Session.GetString("FullName")
                            </span>
                        </li>
                        <li class="nav-item">
                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2">
                                <i class="bi bi-person-heart me-1"></i>@Context.Session.GetString("UserRol")
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-danger btn-sm" asp-area="" asp-controller="User" asp-action="Logout">
                                <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Animacion de cargando-->
    <div id="overlay" class="overlay">
        <div class="loader">
            <img src="/img/Cube-loading.gif" alt="loading..." id="loadingimg" />
            <p>Cargando...</p>
        </div>
    </div>

    <div class="container-fluid admin-container">
        <div class="row">
            <!-- Sidebar vertical del cliente -->
            <aside class="col-lg-2 col-md-3 d-md-block bg-white border-end sidebar-wrapper" id="sidebarCollapse">
                <nav class="navbar navbar-expand-md align-content-start w-100 p-0">
                    <div class="collapse navbar-collapse show d-md-flex flex-column align-items-stretch w-100" id="navbarCollapse">
                        <ul class="nav flex-column w-100 mt-2">
                            <li class="nav-item">
                                <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Mascotas" ? "active" : "")"
                                   asp-controller="Clientes" asp-action="Mascotas">
                                    <i class="bi bi-paw me-2"></i>Mis Mascotas
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Perfil" ? "active" : "")"
                                   asp-controller="Clientes" asp-action="Perfil">
                                    <i class="bi bi-person-lines-fill me-2"></i>Mi Perfil
                                </a>
                            </li>
                        </ul>
                    </div>
                </nav>
            </aside>

            <!-- Contenido central -->
            <main role="main" class="col-lg-10 col-md-9 content-wrapper p-4">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - Veterinaria - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- script de conexion con SweetAlert-->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- script de conexion con DataTable-->
    <script src="https://cdn.datatables.net/v/dt/dt-2.3.8/datatables.min.js"
        integrity="sha384-kjkli48Tmhwhaghq0IIRm8gFmMdnihfu1ywAOyyGWYMsoZZi/6AX2fWzpsqahoFw"
        crossorigin="anonymous"></script>
    <!-- script para usar libreria de zoom-->
    <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>

    <!-- esto es para poder el lenguaje del datable en español-->
    <script>
        $.extend(true, $.fn.dataTable.default, {
            language: {
                url: 'https://cdn.datatables.net/plug-ins/2.3.8/i18n/es-ES.json'
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // Cambio de contraseña obligatorio para cuentas creadas con contraseña temporal
        var debeCambiarPassword = '@Context.Session.GetString("DebeCambiarPassword")';

        $(document).ready(function () {
            if (debeCambiarPassword === 'true') {
                Swal.fire({
                    title: 'Debes cambiar tu contraseña',
                    html:
                        '<div class="text-start">' +
                        '   <label class="form-label fw-semibold">Nueva contraseña</label>' +
                        '   <input type="password" id="swal-new-password" class="form-control mb-3" maxlength="20" placeholder="Ingresa tu nueva contraseña" />' +
                        '   <label class="form-label fw-semibold">Confirmar contraseña</label>' +
                        '   <input type="password" id="swal-confirm-password" class="form-control" maxlength="20" placeholder="Repite la contraseña" />' +
                        '</div>',
                    icon: 'warning',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Cambiar contraseña',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: () => {
                        $('#swal-new-password').on('keypress', function (e) {
                            if (e.which === 13) { Swal.clickConfirm(); }
                        });
                        $('#swal-confirm-password').on('keypress', function (e) {
                            if (e.which === 13) { Swal.clickConfirm(); }
                        });
                    },
                    preConfirm: function () {
                        var pwd = $('#swal-new-password').val();
                        var confirm = $('#swal-confirm-password').val();

                        if (!pwd || !confirm) {
                            Swal.showValidationMessage('Debes llenar ambos campos');
                            return false;
                        }

                        if (pwd !== confirm) {
                            Swal.showValidationMessage('Las contraseñas no coinciden');
                            return false;
                        }

                        return new Promise(function (resolve, reject) {
                            $.ajax({
                                url: '@Url.Action("ChangePassword", "User")',
                                method: 'POST',
                                dataType: 'json',
                                data: { password: pwd, confirmPassword: confirm },
                                success: function (result) {
                                    resolve(result);
                                },
                                error: function (error) {
                                    reject(error.responseJSON?.message || 'Error al cambiar la contraseña');
                                }
                            });
                        });
                    }
                }).then(function (result) {
                    if (result.isConfirmed) {
                        toastMessage('success', 'Contraseña actualizada correctamente');
                    }
                });
            }
        });
    </script>

    <script>
        function toastMessage(type, message) {
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            });

            Toast.fire({
                icon: type,
                title: message
            });
        }

        function alertDelete() {
            return Swal.fire({
                title: '¿Confirmar eliminación?',
                text: '¡No podrás revertir esto!',
                icon: 'question',
                showCancelButton: true,
                cancelButtonText: 'Cancelar',
                confirmButtonText: 'Si, eliminar!',
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
            });
        }

        function alertSucces(message, title = null) {
            const alertTitle = title != null ? title : "Exitoso!";
            return Swal.fire({
                title: alertTitle,
                text: message,
                icon: 'success',
                confirmButtonColor: '#3085d6',
                confirmButtonText: 'Aceptar!',
            });
        }

        function alertWarning(message, title = null) {
            const alertTitle = title != null ? title : "Alerta!";
            return Swal.fire({
                title: alertTitle,
                text: message,
                icon: 'warning',
                confirmButtonColor: '#3085d6',
                confirmButtonText: 'Aceptar!',
            });
        }

        function alertError(message, title = null) {
            const alertTitle = title != null ? title : "Opps!";
            return Swal.fire({
                title: alertTitle,
                text: message,
                icon: 'error',
                confirmButtonColor: '#3085d6',
                confirmButtonText: 'Aceptar!',
            });
        }

        function errorHttp(error) {
            if (error.status == 400 || error.status == 401) {
                alertWarning(error.responseJSON.message)
            } else {
                alertError(error.responseJSON.message)
            }
            console.error(error);
        }

        $(document).ajaxStart(function () {
            $("#overlay").css("display", "flex");
        });

        $(document).ajaxStop(function () {
            $("#overlay").css("display", "none");
        });
    </script>
</body>
</html>